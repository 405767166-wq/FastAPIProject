# ===== 会议纪要智能转写系统 backend 配置示例 =====
# 复制本文件为 backend/.env 后按需修改；V1 默认值已可运行（原生+内存+mock）。
# 字段名与 app/config.py 的 Settings 对应；留空即走 V1 原生/降级路径。

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 存储目录（相对 backend/ 或绝对路径）----
UPLOAD_DIR=./uploads

# ---- V2 扩展：MySQL（版本二；填了 MYSQL_HOST 自动启用 mysql 存储）----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=meeting_minutes

# ---- V2 扩展：Redis（版本二；填了 REDIS_URL 自动启用 redis 队列/词频/进度）----
# 格式示例：redis://:密码@服务器IP:6379/0
REDIS_URL=

# ---- 语音转写：V1 用 mock；V2 换 baidu/whisper 等（缺 key 自动落 mock）----
ASR_PROVIDER=mock
ASR_CHUNK_SECONDS=60

# ---- DeepSeek 总结：V1 留空走模板降级；V2 填真实 key ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
